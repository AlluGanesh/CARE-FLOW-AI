APP_ENV=development
APP_NAME="CARE-FLOW AI Backend"
API_V1_STR=/api
SECRET_KEY=careflow_super_secret_jwt_key_phase3_production_safe
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL supported, defaults to SQLite for portable local development)
DATABASE_URL=sqlite:///./careflow.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careflow_db

# LLM Configuration
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Research Configuration Limits
MAX_RESEARCH_TASKS=20
MAX_SOURCES_PER_TASK=5
MAX_RETRIES=2
RESEARCH_CACHE_TTL_HOURS=24

# Security and CORS
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
