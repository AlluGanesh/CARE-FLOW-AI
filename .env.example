# CARE-FLOW AI - Environment Configuration Example
# Copy this file to .env for local development

# LLM Provider Configuration ('mock' | 'gemini' | 'openai' | 'anthropic')
VITE_LLM_PROVIDER=mock

# External API Key (Keep secret! In production, route via secure backend proxy per Rule 7)
VITE_LLM_API_KEY=

# Trusted Medical Research Source Search Endpoint (Optional custom provider)
VITE_MEDICAL_SEARCH_ENDPOINT=
